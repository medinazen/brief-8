{
  "name": "@js-monorepo/server",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --clear-screen=false ./src/main",
    "db:migrate": "tsx ./bin/migrate",
    "db:seed": "tsx ./bin/seed",
    "build": "tsx ./bin/migrate",
    "start": "tsx ./src/main",
    "test:unitaire": "jest --config jest.config.ts",
    "test:functional": "dotenv -e .env.test -- npx jest --config jest.functional.config.ts"
  },
  "dependencies": {
    "@types/cypress": "^0.1.6",
    "cookie-parser": "^1.4.7",
    "cookieparser": "^0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.14.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/supertest": "^6.0.3",
    "cypress": "^15.13.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
